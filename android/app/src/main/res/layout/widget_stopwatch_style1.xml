<?xml version="1.0" encoding="utf-8"?>
<!-- Style 1: Compacto — título | botones izquierda + contador derecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Título: CRONÓMETRO / TEMPORIZADOR -->
    <TextView
        android:id="@+id/sw_mode_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CRONÓMETRO"
        android:textSize="7sp"
        android:textColor="#FF88AAFF"
        android:gravity="center"
        android:letterSpacing="0.15" />

    <!-- Fila: [botones izquierda]  [−tiempo+] derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <!-- ── Botones izquierda ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">

            <!-- Vuelta (solo cronómetro) -->
            <ImageButton
                android:id="@+id/btn_lap"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_flag"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Vuelta" />

            <!-- Reset -->
            <ImageButton
                android:id="@+id/btn_reset"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_replay"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="Reset" />

            <!-- Play/Pause -->
            <ImageButton
                android:id="@+id/btn_start_pause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_widget_play"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="Play/Pause" />

            <!-- Cambiar modo -->
            <ImageButton
                android:id="@+id/btn_toggle_mode"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_widget_swap_horiz"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="Cambiar modo" />

            <!-- Apagar alarma (solo visible cuando el temporizador llega a cero) -->
            <ImageButton
                android:id="@+id/btn_stop_alarm"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_sw_alarm_off"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Apagar alarma" />

        </LinearLayout>

        <!-- ── Contador derecha: [−] tiempo [+] ── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Restar paso (solo temporizador) -->
            <ImageButton
                android:id="@+id/btn_timer_sub"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_remove"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="-min" />

            <!-- Tiempo -->
            <TextView
                android:id="@+id/sw_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="00:00"
                android:textSize="22sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- Sumar paso (solo temporizador) -->
            <ImageButton
                android:id="@+id/btn_timer_add"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_add"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="+min" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
