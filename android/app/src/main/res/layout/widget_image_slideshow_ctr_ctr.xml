<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="@null" />

    <!-- Botones agrupados en el centro horizontal y vertical -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_image_prev_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/widget_ic_prev"
            android:background="#66000000"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_image_next_btn"
            android:layout_marginStart="8dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/widget_ic_next"
            android:background="#66000000"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@null" />

    </LinearLayout>

</FrameLayout>
