<?xml version="1.0" encoding="utf-8"?>
<!-- Root clickeable → alterna visibilidad de controles.
     Zonas de prev/next son FrameLayouts transparentes de mayor z-order
     que capturan sus propios taps sin que el root los intercepte.
     Las flechas visuales se dibujan directamente sobre el bitmap (en renderFrame)
     para tener control total de color/tamaño/posición/fondo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen principal: scaleType=fitXY porque el bitmap ya viene
         correctamente escalado y centrado desde Kotlin. -->
    <ImageView
        android:id="@+id/widget_image_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="@null" />

    <!-- Zona de tap: anterior (izquierda, ancho fijo).
         Invisible — la flecha visual está dibujada en el bitmap. -->
    <FrameLayout
        android:id="@+id/widget_image_prev_zone"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <!-- Zona de tap: siguiente (derecha). -->
    <FrameLayout
        android:id="@+id/widget_image_next_zone"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@android:color/transparent"
        android:visibility="gone" />

</FrameLayout>
