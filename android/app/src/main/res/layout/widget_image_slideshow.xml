<?xml version="1.0" encoding="utf-8"?>
<!-- El click sobre el ROOT alterna controles.
     Los botones prev/next tienen mayor z-order (están después en el XML)
     y capturan sus propios taps sin que el root los intercepte. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen principal: recibe el Bitmap compuesto (scrim+caption+dots+bordes+radio) -->
    <ImageView
        android:id="@+id/widget_image_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="@null" />

    <!-- Botón Anterior — visible solo cuando controlsVisible=true -->
    <ImageView
        android:id="@+id/widget_image_prev_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_ic_prev"
        android:tint="#FFFFFFFF"
        android:background="#66000000"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Botón Siguiente — visible solo cuando controlsVisible=true -->
    <ImageView
        android:id="@+id/widget_image_next_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="6dp"
        android:src="@drawable/widget_ic_next"
        android:tint="#FFFFFFFF"
        android:background="#66000000"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="@null" />

</FrameLayout>
